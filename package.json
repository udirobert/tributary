{
	"name": "tributary",
	"version": "1.0.0",
	"description": "",
	"main": "index.js",
	"scripts": {
		"postinstall": "node scripts/link-ts6-for-eslint.mjs",
		"lint": "eslint .",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"typecheck": "tsc --noEmit",
		"dev": "wrangler dev",
		"dev:node": "tsx server/index.ts",
		"deploy": "wrangler deploy",
		"simulate": "tsx scripts/simulate.ts",
		"test:merge": "tsx scripts/test-merge.ts",
		"test:typescript": "tsx scripts/test-typescript-gate.ts",
		"test:node": "tsx scripts/test-node-env.ts",
		"test:sandbox": "tsx scripts/test-sandbox.ts",
		"test": "tsx scripts/test-merge.ts && tsx scripts/test-typescript-gate.ts && tsx scripts/test-node-env.ts && tsx scripts/test-sandbox.ts",
		"bench": "tsx eval/runner.ts",
		"audit": "tsx scripts/audit.ts",
		"pr-gate": "tsx scripts/pr-gate.ts",
		"bench:quiet": "tsx eval/runner.ts --quiet",
		"tributary": "tsx scripts/tributary.ts",
		"mcp": "tsx scripts/mcp.ts",
		"prepare": "husky"
	},
	"keywords": [],
	"author": "",
	"license": "MIT",
	"type": "commonjs",
	"lint-staged": {
		"*.{ts,mts,cts,js,mjs,cjs}": [
			"eslint --fix",
			"prettier --write"
		],
		"*.{json,md,yml,yaml,html,css}": [
			"prettier --write"
		]
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20261003.1",
		"@eslint/js": "^10.0.1",
		"@typescript/typescript6": "^6.0.2",
		"eslint": "^10.12.0",
		"globals": "^17.13.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.0",
		"prettier": "^3.9.9",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2",
		"typescript-eslint": "^8.71.0",
		"wrangler": "^4.147.0"
	},
	"dependencies": {
		"acorn": "^8.19.0",
		"isomorphic-git": "^1.42.6",
		"memfs": "^4.80.0"
	}
}
